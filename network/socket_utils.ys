package socket_utils
import ["socket"]

@request HEAD
# request(protocol, host, port, payload, timeout_ms) 创建 socket、连接、写入并读取最多
#   4096 字节。
# protocol 仅支持 tcp/udp/tls；timeout_ms 是毫秒，传给 Socket 后由 set_timeout
#   设置读写超时。 返回 recv 结果；网络策略、连接、发送及接收错误会抛出；
#   defer 确保连接关闭。
@request END
func request(protocol, host, port, payload, timeout_ms) {
    let client = socket.Socket(protocol)
    defer client.close()
    client.set_timeout(timeout_ms)
    client.connect(host, int(port))
    client.write(payload)
    return client.recv(4096)
}

@tcp_request HEAD
# tcp_request(host, port, payload, timeout_ms) 调用标准库 TCP 便捷请求并返回其响应。
# timeout_ms 单位为毫秒；需要网络权限。连接/IO 错误及超时遵从底层异常。
@tcp_request END
func tcp_request(host, port, payload, timeout_ms) {
    return socket.tcp_request(host, int(port), payload, timeout_ms)
}

@tls_request HEAD
# tls_request(host, port, payload, timeout_ms) 通过标准库 TLS 便捷请求并返回其响应。
# timeout_ms 单位为毫秒；需要网络权限并验证对端证书。 TLS
#   握手、证书验证、连接或 IO 失败会按底层异常抛出。
@tls_request END
func tls_request(host, port, payload, timeout_ms) {
    return socket.tls_request(host, int(port), payload, timeout_ms)
}
